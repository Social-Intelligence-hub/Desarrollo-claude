# ============================================================
# Social Intelligence Hub v3 - Variables de entorno (Scraper)
# Copiar como .env y completar con valores reales.
# NUNCA commitear .env (está en .gitignore).
# ============================================================

# --- Supabase ---
# El scraper escribe en la BD: requiere la SERVICE ROLE KEY (lado servidor).
# Obtener en: Supabase Dashboard -> Settings -> API -> service_role (secret).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Gemini 2.0 Flash (NLP en cascada) ---
# Obtener en: https://aistudio.google.com/apikey  (formato típico: AIza...)
GEMINI_API_KEY=AIza...

# --- Meta Graph API (Instagram + Facebook) ---
# Opcional. Si faltan, los colectores Meta operan en modo stub (retornan []).
# Una sola credencial centralizada por instancia (ver PROYECTO.md 7.3).
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=

# --- Reddit (opcional) ---
# El colector usa la API JSON pública por defecto. Estas claves solo dan mayor volumen.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialIntelligenceHub/1.0
